# ─── Server ───────────────────────────────
SERVER_PORT=8080
GIN_MODE=release

# ─── Database (PostgreSQL) ────────────────
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=CHANGE_ME
DB_NAME=postgres
DB_SSLMODE=require

# ─── Redis ────────────────────────────────
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_TLS=true

# ─── JWT ──────────────────────────────────
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32
JWT_EXPIRY_HOURS=24

# Google OAuth (required to enable verified Google sign-in)
GOOGLE_OAUTH_CLIENT_ID=your-google-web-oauth-client-id.apps.googleusercontent.com

# ─── Logging ─────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ─── AI (Gemini) ─────────────────────────
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.0-flash

# ─── Email (SendGrid) ───────────────────
SENDGRID_API_KEY=CHANGE_ME
SENDGRID_FROM=no-reply@khair.it.com

# ─── Uploads ─────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Azure Blob Storage ──────────────────
STORAGE_PROVIDER=r2
R2_PUBLIC_BUCKET=khair-public
R2_PUBLIC_BASE_URL=https://media.example.com

# --- Cloudflare R2 media (required for production uploads) ---
# Organizer logos, representative images, and verification documents deliberately
# never fall back to local disk or public storage. Use a bucket with Block Public
# Access enabled; the API creates short-lived signed URLs for approved public
# logos and for admin-only document viewing.
R2_PRIVATE_BUCKET=khair-private
R2_REGION=auto
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# ─── Public event-sharing URLs ────────────
# Root URL of the public Render API (no /api/v1). Its /events/:id response
# includes Open Graph tags for WhatsApp, LinkedIn, Telegram, X, and Facebook.
PUBLIC_BASE_URL=https://your-khair-api.onrender.com
# Public Vercel web app. People who open a shared event are redirected here.
FRONTEND_URL=https://your-khair.vercel.app

# Optional override for the logo rendered by transactional email. By default
# the API serves the embedded approved logo at PUBLIC_BASE_URL/brand/khair-logo.png.
KHAIR_BRAND_LOGO_URL=

# ─── Sentry (Error Tracking) ─────────────
SENTRY_DSN=
