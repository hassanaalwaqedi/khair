# ─── Server ───────────────────────────────
SERVER_PORT=8080
GIN_MODE=debug

# ─── Database (PostgreSQL) ────────────────
DB_HOST=localhost
DB_PORT=25432
DB_USER=khair
DB_PASSWORD=
DB_NAME=khair
DB_SSLMODE=disable

# ─── Redis ────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── JWT ──────────────────────────────────
JWT_SECRET=
JWT_EXPIRY_HOURS=24

# ─── Google OAuth ─────────────────────────
GOOGLE_OAUTH_CLIENT_ID=

# ─── Logging ─────────────────────────────
LOG_LEVEL=debug
LOG_PRETTY=true

# ─── AI (Gemini) — backend only ──────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1024

# ─── Email (Resend) ─────────────────────
RESEND_API_KEY=
EMAIL_FROM=no-reply@khair.it.com
EMAIL_FROM_NAME=Khair

# ─── Uploads ─────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Cloudflare R2 Storage ───────────────
STORAGE_PROVIDER=r2
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=khair-public
R2_PRIVATE_BUCKET=khair-private

# ─── Frontend URL (CORS) ─────────────────
FRONTEND_URL=http://localhost:7357

# ─── Sentry (Error Tracking) ─────────────
SENTRY_DSN=

# ─── Firebase Cloud Messaging ────────────
# Place firebase-service-account.json in backend/ root
# Or set FCM_SERVICE_ACCOUNT env var with the JSON content
