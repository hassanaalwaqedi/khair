# Khair production API — Render + Supabase Postgres + Cloudflare R2
# Copy values into Render's Environment page. Never commit a populated file.

ENV=production
GIN_MODE=release

# Render supplies PORT automatically. Do not set SERVER_PORT in Render.

# Supabase Postgres. Use the connection host and credentials shown in
# Supabase: Connect > Session pooler, then keep SSL required.
DB_HOST=aws-0-your-region.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.your-project-ref
DB_PASSWORD=CHANGE_ME
DB_NAME=postgres
DB_SSLMODE=require

# A Redis-compatible service is required for live notifications, WebSocket
# fan-out, caching, and production rate limits. Use its TCP endpoint.
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_TLS=true

JWT_SECRET=GENERATE_A_32_BYTE_OR_LONGER_SECRET
JWT_EXPIRY_HOURS=24

# Public deployed domains. No trailing slash.
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CORS_ORIGINS=https://app.example.com

# Google sign-in: use the Web OAuth client ID, not an Android client ID.
GOOGLE_OAUTH_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Cloudflare R2. Create TWO buckets: public assets and private organizer evidence.
# R2_PUBLIC_BASE_URL is the HTTPS custom domain connected to the public bucket.
STORAGE_PROVIDER=r2
R2_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_PUBLIC_BUCKET=khair-public
R2_PUBLIC_BASE_URL=https://media.example.com
R2_PRIVATE_BUCKET=khair-private

# Firebase Cloud Messaging HTTP v1. In Render, store the complete service
# account JSON as the secret FCM_SERVICE_ACCOUNT. Do not deploy a JSON file and
# do not use the retired FCM_SERVER_KEY.
FCM_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-firebase-project",...}

# Optional integrations
RESEND_API_KEY=
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=Khair
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=1024
SENTRY_DSN=
