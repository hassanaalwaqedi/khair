# ═══════════════════════════════════════════
# Khair — .gitignore
# ═══════════════════════════════════════════

# ─── Environment & Secrets ────────────────
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.p12
*.jks
*.keystore
key.properties
firebase-service-account.json
service-account*.json
credentials*.json
google-services.json
GoogleService-Info.plist
# Firebase Android client configuration contains project identifiers, not the
# backend service-account secret. Track this one required release-build file.
!frontend/khair_app/android/app/google-services.json

# ─── IDE ──────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.iml

# ─── OS ───────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Go ───────────────────────────────────
backend/bin/
backend/tmp/
backend/uploads/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out

# ─── Flutter / Dart ───────────────────────
frontend/khair_app/.dart_tool/
frontend/khair_app/.packages
frontend/khair_app/build/
frontend/khair_app/.flutter-plugins
frontend/khair_app/.flutter-plugins-dependencies
frontend/khair_app/.metadata
frontend/khair_app/android/build/
frontend/khair_app/android/.gradle/
frontend/khair_app/ios/Pods/
frontend/khair_app/ios/.symlinks/

# ─── Dependencies ─────────────────────────
node_modules/
vendor/

# ─── Logs ─────────────────────────────────
*.log
logs/
crash.log

# ─── Build / Artifacts ────────────────────
*.zip
*.tar.gz
*.rar
*.apk
*.aab

# ─── Uploads (user content) ──────────────
uploads/

# ─── Docker ───────────────────────────────
docker-compose.override.yml

# ─── Debug screenshots / temp files ──────
*.tmp-*.png
analyze*.txt
flutter_analyze.txt
*-check*.png
*-browser*.png
*-verified*.png
*-restarted*.png
*-seeded*.png
*-auth-gate*.png
*-current*.png
*-launch*.png
*-rerun*.png
run-check.png
